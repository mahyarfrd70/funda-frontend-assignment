{
  "name": "funda-frontend-assignment",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:all": "vitest run",
    "coverage": "vitest run --project unit --coverage",
    "prepare": "husky",
    "docker:build": "docker build -t funda-frontend-assignment .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env funda-frontend-assignment"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "leaflet": "1.9.4",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "4.2.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/leaflet": "1.9.22",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "10.6.0",
    "happy-dom": "20.14.0",
    "husky": "9.1.7",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.6.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
